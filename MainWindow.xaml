<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="680" Height="622"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True"
        FontFamily="./Fonts/#SF Pro Text, SF Pro Text, Segoe UI Variable Display, Segoe UI" Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Green" Color="#30D158"/>
        <SolidColorBrush x:Key="Red" Color="#FF453A"/>
        <SolidColorBrush x:Key="Indigo" Color="#7D7AFF"/>
        <SolidColorBrush x:Key="Faint" Color="#66FFFFFF"/>

        <FontFamily x:Key="Display">./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI</FontFamily>

        <LinearGradientBrush x:Key="ArtPlaceholder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#48484A" Offset="0"/>
            <GradientStop Color="#1C1C1E" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Squish"/>
                            </Grid.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>

        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:Icon Kind="Back" Width="10" Height="10" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIcon" TargetType="local:Icon">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Fill" Value="{StaticResource Dim}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="29,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowChevron" TargetType="local:Icon">
            <Setter Property="Kind" Value="Chevron"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Fill" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowSwitch" TargetType="local:Toggle">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <local:ChipCorners x:Key="ChipCorners"/>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ChipCorners}}" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Shine" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ChipCorners}}" Background="White" Opacity="0"/>
                            <Border x:Name="Press" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ChipCorners}}" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="1.5" Opacity="0"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Swell"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowSlider" TargetType="local:Scrubber">
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,48,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowSegments" TargetType="local:Segments">
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Squish"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Plate" CornerRadius="11" Background="White" Opacity="0.08"/>
                            <ContentPresenter Margin="3,3,3,21"/>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            <Border x:Name="Ring" CornerRadius="11" BorderBrush="White" BorderThickness="1.5" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="Root" Width="620" Height="592" Opacity="0"
          HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0"
          MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseMove="Root_MouseMove"
          MouseRightButtonUp="Root_MouseRightButtonUp" MouseUp="Root_MouseUp" MouseWheel="Root_MouseWheel"
          AllowDrop="True" DragEnter="Root_DragOver" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="RootMove"/>
                <TranslateTransform x:Name="RootLean"/>
                <ScaleTransform x:Name="RootSize"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid x:Name="Island" RenderTransformOrigin="0.5,0"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              LostMouseCapture="Island_LostMouseCapture">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale"/>
            </Grid.RenderTransform>

            <Path x:Name="Shadow" Fill="Black" Opacity="0" IsHitTestVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
                </Path.Effect>
            </Path>

            <local:Goo x:Name="Body" IsHitTestVisible="False"/>

            <Border x:Name="Pill" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <Grid x:Name="Host">

                <Grid x:Name="IdleView" Width="118" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Digits x:Name="IdleClock" Text="00:00" FontSize="13.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="MediaView" Width="210" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Canvas x:Name="LyricBox" Height="34" Margin="36,0,41,0"
                            Background="Transparent" ClipToBounds="True" IsHitTestVisible="False"
                            SizeChanged="LyricBox_SizeChanged">
                        <Canvas.OpacityMask>
                            <LinearGradientBrush x:Name="LyricMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="133,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop x:Name="LyricMaskIn" Color="Black" Offset="0.06"/>
                                <GradientStop x:Name="LyricMaskOut" Color="Black" Offset="0.94"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Canvas.OpacityMask>
                        <local:CompactLyric x:Name="LyricA" Opacity="0"/>
                        <local:CompactLyric x:Name="LyricB" Opacity="0"/>
                    </Canvas>
                </Grid>

                <Grid x:Name="TimerView" Width="132" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Ring x:Name="TimerRing" Width="18" Height="18"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <local:Digits x:Name="TimerText" Text="25:00" FontSize="13.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <Grid x:Name="RecordView" Width="132" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="{StaticResource Red}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <local:Digits x:Name="RecordText" Text="0:00" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Red}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <Grid x:Name="LoadingView" Width="118" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Ring x:Name="LoadingRing" Width="18" Height="18" Progress="0" Stroke="{StaticResource Orange}"
                                RenderTransformOrigin="0.5,0.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0">
                        <local:Ring.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </local:Ring.RenderTransform>
                    </local:Ring>
                    <local:Digits x:Name="LoadingText" Text="0%" FontSize="13.5" FontWeight="SemiBold"
                                  Foreground="{StaticResource Orange}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <Grid x:Name="VolumeView" Width="250" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="162"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:Icon x:Name="VolIcon" Kind="Loud" Width="17" Height="17"/>
                    <Grid x:Name="VolTrack" Grid.Column="1" Height="5" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="VolStretch"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                        <Border x:Name="VolFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <local:Digits x:Name="VolText" Grid.Column="2" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="ChargeView" Width="230" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Icon Kind="Bolt" Width="16" Height="16" Fill="{StaticResource Green}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                        <local:Icon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BoltSize"/>
                                <RotateTransform x:Name="BoltTurn"/>
                            </TransformGroup>
                        </local:Icon.RenderTransform>
                    </local:Icon>
                    <TextBlock Text="Зарядка" FontSize="13" FontWeight="SemiBold" Margin="33,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <local:Digits x:Name="ChargeText" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#30D158"
                                      VerticalAlignment="Center"/>
                        <Grid Width="27" Height="13" Margin="7,0,0,0" VerticalAlignment="Center">
                            <Border Width="24" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="{StaticResource Faint}" BorderThickness="1"/>
                            <Border x:Name="ChargeFill" Width="20" Height="9" Margin="2,0,0,0" CornerRadius="2.5" Background="#30D158"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Border Width="2" Height="5" CornerRadius="0,1,1,0" Background="{StaticResource Faint}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FocusView" Width="236" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Icon x:Name="FocusIcon" Kind="Moon" Width="18" Height="18" Fill="{StaticResource Indigo}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                        <local:Icon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FocusSize"/>
                                <RotateTransform x:Name="FocusTurn"/>
                            </TransformGroup>
                        </local:Icon.RenderTransform>
                    </local:Icon>
                    <TextBlock Text="Не беспокоить" FontSize="13" FontWeight="SemiBold" Margin="39,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FocusText" Text="Вкл." FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Indigo}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                </Grid>

                <Grid x:Name="ToastView" Width="340" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="68,0,58,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToastArtist" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="NoticeView" Width="320" Height="64" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border x:Name="NoticeBack" Width="40" Height="40" CornerRadius="11" Background="#1FFFFFFF"
                            HorizontalAlignment="Left" Margin="12,0,0,0">
                        <local:Icon x:Name="NoticeIcon" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                            <local:Icon.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NoticeSize"/>
                                    <RotateTransform x:Name="NoticeTurn"/>
                                    <TranslateTransform x:Name="NoticeMove"/>
                                </TransformGroup>
                            </local:Icon.RenderTransform>
                        </local:Icon>
                    </Border>
                    <StackPanel Margin="64,0,22,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NoticeTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MediaBigView" Width="380" Height="176" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Aura x:Name="Glow" Height="176" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                    <local:StarField x:Name="PlayerStars" Height="176" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <local:DotMatrix x:Name="PlayerMatrix" Height="176" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"/>

                    <Grid Height="64" Margin="20,20,22,0" VerticalAlignment="Top">
                        <StackPanel Margin="78,0,52,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleBig" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistBig" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0"
